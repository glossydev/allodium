  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.38.0"
  },
  "devDependencies": {
    "drizzle-orm": "^0.45.0"
  }
}
