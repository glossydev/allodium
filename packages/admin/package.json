{
  "name": "@allodium/admin",
  "version": "0.1.0",
  "description": "Schema-driven CRUD admin generated from your Drizzle schema — no parallel config language.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./view": {
      "types": "./dist/view.d.ts",
      "import": "./dist/view.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./view.schema.json": "./view.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "view.schema.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node test/view-schema.mjs && node test/view-store.mjs && node test/masking.mjs && node test/filter.mjs && node test/related.mjs && node test/access.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.38.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "drizzle-orm": "^0.45.0",
    "react": "^19.1.0"
  }
}
