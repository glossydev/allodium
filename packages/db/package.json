{
  "name": "@allodium/db",
  "version": "0.2.0",
  "description": "Postgres data-layer conventions for Allodium: pooling, transactions, typed query-module patterns on Drizzle + node-postgres.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glossydev/allodium.git",
    "directory": "packages/db"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.38.0",
    "pg": ">=8.11.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "drizzle-orm": "^0.45.0",
    "pg": "^8.13.0"
  },
  "engines": {
    "node": ">=20"
  }
}
