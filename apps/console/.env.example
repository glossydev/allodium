# Allodium developer console — local dev config.
# The console is a localhost dev tool in v1: no auth, binds localhost only.
# Serves on port 3180 (3000/3100 are taken by other local dev servers).

# The database the console operates on (the allodium_dev seed container).
DATABASE_URL=postgresql://chapterhub_user:localdev@localhost:5433/allodium_dev

# Where @allodium/storage keeps uploaded bytes (metadata lives in the files table).
# Defaults to <app>/.uploads when unset.
# UPLOADS_DIR=

# SQL silo connection: a role with only SELECT (dev/seed/004-readonly-role.sql).
# Without it the SQL console falls back to the app role and says so in the footer.
CONSOLE_RO_DATABASE_URL=postgresql://allodium_ro:readonly@localhost:5433/allodium_dev

# Masking overrides (runtime, comma-separated "table.col" or bare "col"):
# CONSOLE_MASK_EXTRA=customers.notes
# CONSOLE_MASK_EXEMPT=orders.token_type
